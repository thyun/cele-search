{
  "name": "cele-search",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "batch": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/batch.mjs",
    "batch:channels": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/batch.mjs channels",
    "batch:videos": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/batch.mjs videos",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "mysql2": "^3.14.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
